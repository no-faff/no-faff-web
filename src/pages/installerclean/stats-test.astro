---
import BaseLayout from '@layouts/BaseLayout.astro';

// DRAFT test page. The runs below are SAMPLE data, not real reports, so the chart can be settled
// before wiring real reports from a per-record endpoint. Route is unlinked.

type Run = { month: string; gb: number; missing: number };

// One entry per summary sent in, oldest first. Real reports only exist from v1.8.0 (13 May 2026)
// onward, so they all sit in May 2026 for now; the x-axis grows month labels as time passes.
const runs: Run[] = [
  { month: 'May 2026', gb: 0, missing: 0 },
  { month: 'May 2026', gb: 0, missing: 0 },
  { month: 'May 2026', gb: 25.0, missing: 0 },
  { month: 'May 2026', gb: 0, missing: 0 },
  { month: 'May 2026', gb: 9.1, missing: 1 },
  { month: 'May 2026', gb: 0, missing: 0 },
  { month: 'May 2026', gb: 16.2, missing: 0 },
  { month: 'May 2026', gb: 0, missing: 0 },
  { month: 'May 2026', gb: 0, missing: 2 },
  { month: 'May 2026', gb: 0.965, missing: 0 },
  { month: 'May 2026', gb: 0, missing: 0 },
  { month: 'May 2026', gb: 13.5, missing: 0 },
  { month: 'May 2026', gb: 0, missing: 0 },
  { month: 'May 2026', gb: 0, missing: 0 },
  { month: 'May 2026', gb: 19.8, missing: 3 },
  { month: 'May 2026', gb: 0, missing: 0 },
  { month: 'May 2026', gb: 5.4, missing: 0 },
  { month: 'May 2026', gb: 0, missing: 0 },
  { month: 'May 2026', gb: 0, missing: 0 },
  { month: 'May 2026', gb: 0, missing: 0 },
  { month: 'May 2026', gb: 0, missing: 0 },
  { month: 'May 2026', gb: 0, missing: 0 },
];

function formatFreed(gb: number): string {
  if (gb <= 0) return 'Nothing';
  if (gb >= 1) return `${parseFloat(gb.toFixed(1))} GB`;
  return `${Math.round(gb * 1024)} MB`;
}

const runCount = runs.length;
const winGbs = runs.filter((r) => r.gb > 0).map((r) => r.gb);
const freedCount = winGbs.length;
const minFreed = winGbs.length ? Math.min(...winGbs) : 0;
const maxFreed = winGbs.length ? Math.max(...winGbs) : 0;

// Chart geometry, in viewBox units.
const W = 960;
const H = 360;
const PX0 = 54;
const PX1 = 938;
const PY0 = 28;
const PY1 = 306;
const PW = PX1 - PX0;
const PH = PY1 - PY0;

const yStep = 10;
const yMax = Math.ceil(Math.max(1, maxFreed) / yStep) * yStep;
const gridLines = [];
for (let v = 0; v <= yMax; v += yStep) {
  gridLines.push({ v, y: PY1 - (v / yMax) * PH });
}

const slotW = PW / runCount;
const barW = Math.min(slotW * 0.6, 24);

const bars = runs.map((r, i) => {
  const cx = PX0 + (i + 0.5) * slotW;
  const win = r.gb > 0;
  const h = win ? Math.max(6, (r.gb / yMax) * PH) : 4;
  const y = PY1 - h;
  return {
    cx,
    x: cx - barW / 2,
    y,
    h,
    win,
    fill: win ? 'var(--success)' : 'var(--text-subtle)',
    missing: r.missing > 0,
    dotY: y - 12,
    tip: win ? `${formatFreed(r.gb)} freed` : 'Nothing to remove',
  };
});

const groups: { label: string; start: number; end: number }[] = [];
runs.forEach((r, i) => {
  const g = groups[groups.length - 1];
  if (g && g.label === r.month) g.end = i;
  else groups.push({ label: r.month, start: i, end: i });
});
const monthLabels = groups.map((g) => ({
  label: g.label,
  cx: PX0 + ((g.start + g.end + 1) / 2) * slotW,
}));
---

<BaseLayout
  title="InstallerClean usage (draft)"
  description="Draft chart of how much space InstallerClean has freed."
>
  <section class="stats">
    <div class="inner">
      <p class="draft-flag">Draft preview. Sample data, not real reports, so the chart can be settled first.</p>

      <h1>How much space InstallerClean frees</h1>
      <p class="sub">Each bar is one summary sent in. {freedCount} of the {runCount} freed space, from {formatFreed(minFreed)} to {formatFreed(maxFreed)}; the rest found a tidy folder.</p>

      <figure class="chart">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Bar chart of disk space freed by InstallerClean, one bar per run">
          {
            gridLines.map((g) => (
              <g>
                <line x1={PX0} y1={g.y} x2={PX1} y2={g.y} class="grid" />
                <text x={PX0 - 12} y={g.y} class="y-label" text-anchor="end" dominant-baseline="middle">
                  {g.v === 0 ? '0' : `${g.v} GB`}
                </text>
              </g>
            ))
          }
          <line x1={PX0} y1={PY1} x2={PX1} y2={PY1} class="axis" />
          {
            bars.map((b) => (
              <g>
                <rect x={b.x} y={b.y} width={barW} height={b.h} rx="3" class="bar" style={`fill:${b.fill}`} data-tip={b.tip} />
                {b.missing && <circle cx={b.cx} cy={b.dotY} r="4.5" class="marker" />}
              </g>
            ))
          }
          {
            monthLabels.map((m) => (
              <text x={m.cx} y={PY1 + 30} class="x-label" text-anchor="middle">
                {m.label}
              </text>
            ))
          }
        </svg>
        <div class="chart-tip" aria-hidden="true"></div>
      </figure>

      <p class="footnote">
        <span class="dot" aria-hidden="true"></span>
        The dot marks runs where Windows still expects installer files that aren't on disk. InstallerClean didn't cause that; it never touches the files Windows needs, and nothing is broken now. It usually traces to a previous cleanup tool, a failed Windows update or antivirus quarantine. One thing to know: if you later repair, change or uninstall the affected software, Windows may ask for its original installer, so it is worth keeping those to hand.
      </p>
    </div>
  </section>

  <script>
    const chart = document.querySelector('.chart');
    const tip = chart && chart.querySelector('.chart-tip');
    if (chart && tip) {
      chart.querySelectorAll('.bar').forEach((bar) => {
        bar.addEventListener('pointerenter', () => {
          tip.textContent = bar.getAttribute('data-tip') || '';
          const b = bar.getBoundingClientRect();
          const c = chart.getBoundingClientRect();
          tip.style.left = `${b.left - c.left + b.width / 2}px`;
          tip.style.top = `${b.top - c.top}px`;
          tip.dataset.show = 'true';
        });
        bar.addEventListener('pointerleave', () => {
          tip.dataset.show = 'false';
        });
      });
    }
  </script>
</BaseLayout>

<style>
  .stats {
    padding: var(--space-16) var(--space-6);
  }
  .inner {
    max-width: var(--container);
    margin: 0 auto;
  }
  .draft-flag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    background: var(--bg-subtle);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-4);
    margin: 0 0 var(--space-8);
  }
  .stats h1 {
    margin: 0 0 var(--space-4);
  }
  .sub {
    text-wrap: wrap;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-muted);
    margin: 0 0 var(--space-8);
  }
  .chart {
    position: relative;
    margin: 0;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
  .chart svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .chart-tip {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, calc(-100% - 9px));
    padding: var(--space-1) var(--space-3);
    background: var(--text);
    color: var(--bg);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: var(--weight-medium);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 90ms var(--ease-out);
  }
  .chart-tip[data-show='true'] {
    opacity: 1;
  }
  .chart-tip::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -3px;
    width: 8px;
    height: 8px;
    background: var(--text);
    border-radius: 1px;
    transform: translateX(-50%) rotate(45deg);
  }
  .grid {
    stroke: var(--border);
    stroke-width: 1;
  }
  .axis {
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }
  .y-label,
  .x-label {
    fill: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 13px;
  }
  .x-label {
    font-weight: var(--weight-medium);
  }
  .bar {
    cursor: default;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .bar:hover {
    opacity: 0.8;
  }
  .marker {
    fill: var(--chick);
    stroke: var(--bg-raised);
    stroke-width: 1.5;
  }
  .footnote {
    text-wrap: wrap;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-muted);
    margin: var(--space-6) 0 0;
  }
  .dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--chick);
    margin-right: var(--space-1);
  }
</style>
