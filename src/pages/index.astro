---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import chick from '@assets/brand/chick.png';

const projects = [
  {
    name: 'InstallerClean',
    status: 'Shipped',
    statusKind: 'shipped',
    oneLiner: 'Safely clean up the hidden Windows folder that quietly eats your disk space.',
    href: '/installerclean',
  },
  {
    name: 'Silo',
    status: 'Shipped',
    statusKind: 'shipped',
    oneLiner:
      'Browser picker for Linux that routes links to the right browser and profile. Windows and macOS versions coming.',
    href: '/silo',
  },
  {
    name: 'Cookie Jar',
    status: 'Coming soon',
    statusKind: 'in-development',
    oneLiner: 'Auto-delete cookies when tabs close. Keep the sites you trust.',
    href: '/cookie-jar',
  },
  {
    name: 'Simple Video Downloader',
    status: 'Shipped',
    statusKind: 'shipped',
    oneLiner:
      'Firefox extension for downloading videos and audio with yt-dlp. Version 10 rewrite landing soon.',
    href: '/simple-video-downloader',
  },
  {
    name: 'Ulauncher extensions',
    status: 'Shipped',
    statusKind: 'shipped',
    oneLiner:
      'Four small extensions for Ulauncher: dictionary, file find, video downloader, calculator.',
    href: '/ulauncher',
  },
];
---

<BaseLayout
  title="No Faff"
  description="Small open-source tools by Fred. InstallerClean, Silo, Cookie Jar, Simple Video Downloader and Ulauncher extensions."
>
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="hero-inner">
      <Image src={chick} alt="" width={96} height={96} class="mascot" />
      <h1>No Faff</h1>
      <p class="lead">
        A few unrelated things I made because nothing existing did exactly what I wanted. They
        might be useful to you too. Free and open source.
      </p>
    </div>
  </section>

  <section class="projects-section" id="projects">
    <div class="projects-inner">
      <h2>Projects</h2>
      <ul class="project-list">
        {
          projects.map((p) => (
            <li>
              <a class={`card ${p.statusKind}`} href={p.href}>
                <div class="head">
                  <h3>{p.name}</h3>
                  <span class="status">{p.status}</span>
                </div>
                <p>{p.oneLiner}</p>
                <span class="more">
                  Read more
                  <Icon name="lucide:arrow-right" class="more-icon" aria-hidden="true" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: var(--space-24) var(--space-6) var(--space-12);
  }
  .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--hero-glow);
  }
  .hero-inner {
    position: relative;
    max-width: var(--container-narrow);
    margin: 0 auto;
    text-align: center;
  }
  .mascot {
    margin: 0 auto var(--space-6);
    border-radius: var(--radius-lg);
  }
  .hero h1 {
    margin-bottom: var(--space-4);
  }
  .lead {
    color: var(--text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .projects-section {
    padding: var(--space-8) var(--space-6) var(--space-16);
  }
  .projects-inner {
    max-width: var(--container-narrow);
    margin: 0 auto;
  }
  .projects-section h2 {
    margin-bottom: var(--space-6);
  }
  .project-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--text);
    transition:
      transform var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .head h3 {
    margin: 0;
  }
  .status {
    font-size: var(--text-xs);
    color: var(--text-subtle);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    flex-shrink: 0;
  }
  .card.shipped .status {
    color: var(--success);
  }
  .card.in-development .status {
    color: var(--accent);
  }
  .card p {
    color: var(--text-muted);
    margin: 0;
  }
  .more {
    margin-top: auto;
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .more-icon {
    width: 14px;
    height: 14px;
  }
</style>
