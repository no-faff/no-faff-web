---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  items: Item[];
}

const { eyebrow, title, items } = Astro.props as Props;
---

<section class="reel">
  <div class="inner">
    {
      (eyebrow || title) && (
        <header>
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && <h2>{title}</h2>}
        </header>
      )
    }
    <div class="items">
      {
        items.map((item) => (
          <figure>
            <figcaption>{item.caption}</figcaption>
            <Image src={item.src} alt={item.alt} />
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .reel {
    padding: var(--space-16) var(--space-6);
    background: var(--bg-subtle);
  }
  .inner {
    max-width: var(--container);
    margin: 0 auto;
  }
  header {
    text-align: center;
    margin-bottom: var(--space-14);
  }
  header h2 {
    margin-top: var(--space-2);
  }
  .items {
    display: grid;
    gap: var(--space-20);
  }
  figure {
    margin: 0;
  }
  figcaption {
    max-width: 62ch;
    margin: 0 0 var(--space-5);
    color: var(--text);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }
  figure :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }
</style>
