---
import { Image } from 'astro:assets';
import ThemeToggle from './ThemeToggle.astro';
import { Icon } from 'astro-icon/components';
import chick from '@assets/brand/chick.png';
---

<header class="topnav">
  <div class="topnav-inner">
    <a href="/" class="brand" aria-label="No Faff home">
      <Image src={chick} alt="" width={32} height={32} class="brand-icon" />
      <span class="brand-text">no faff</span>
    </a>

    <nav class="links" aria-label="Primary">
      <a href="https://github.com/no-faff" target="_blank" rel="noopener" class="ext">
        GitHub
        <Icon name="lucide:arrow-up-right" class="external-icon" aria-hidden="true" />
      </a>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .topnav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .topnav-inner {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: var(--space-4) var(--space-6);
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--text);
  }
  .brand-text { font-size: var(--text-base); }
  .brand-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .links {
    display: flex;
    gap: var(--space-6);
    margin-left: auto;
    align-items: center;
  }
  .links a {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition: color var(--duration-fast) var(--ease-out);
  }
  .links a:hover { color: var(--text); }
  .links .ext { display: inline-flex; align-items: center; gap: 4px; }
  .external-icon { width: 12px; height: 12px; opacity: 0.7; }

  @media (max-width: 640px) {
    .topnav-inner {
      gap: var(--space-4);
      padding: var(--space-3) var(--space-4);
    }
    .links { gap: var(--space-4); }
  }
</style>
